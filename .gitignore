# =============================================================================
# MY School ERP — repository ignore rules
# =============================================================================
# Strategy: this repo tracks our `myschools` app + project-level docs/meta.
# The Frappe bench (frappe-bench/) is a runtime environment — only the path
# `frappe-bench/apps/myschools/` (our custom app) is committed; everything
# else under the bench is regenerated by `bench init` and the recreation
# script in the README.

# Ignore the entire bench by default …
frappe-bench/*

# … but un-ignore our app inside it.
!frappe-bench/apps
frappe-bench/apps/*
!frappe-bench/apps/myschools

# -----------------------------------------------------------------------------
# Inside our app: standard Python / Frappe excludes
# -----------------------------------------------------------------------------
frappe-bench/apps/myschools/**/__pycache__/
frappe-bench/apps/myschools/**/*.py[cod]
frappe-bench/apps/myschools/**/*$py.class
frappe-bench/apps/myschools/**/.pytest_cache/
frappe-bench/apps/myschools/**/.ruff_cache/
frappe-bench/apps/myschools/**/.mypy_cache/
frappe-bench/apps/myschools/**/.coverage
frappe-bench/apps/myschools/**/htmlcov/
frappe-bench/apps/myschools/**/*.egg-info/
frappe-bench/apps/myschools/**/build/
frappe-bench/apps/myschools/**/dist/
frappe-bench/apps/myschools/**/node_modules/
# Playwright hoists deps to app root; public/ is a symlink — ignore the link too.
frappe-bench/apps/myschools/myschools/public/node_modules

# Playwright (Phase-5 browser tests) — installs + outputs are local-only
frappe-bench/apps/myschools/test-results/
frappe-bench/apps/myschools/playwright-report/
frappe-bench/apps/myschools/playwright/.cache/

# -----------------------------------------------------------------------------
# Editor / OS
# -----------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Local Claude metadata (per-user, not for the repo)
# -----------------------------------------------------------------------------
.claude/

# -----------------------------------------------------------------------------
# Secrets / env
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# -----------------------------------------------------------------------------
# Logs / temp
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
